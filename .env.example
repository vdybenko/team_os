# Public URL in sign-in emails. Use HTTPS in production.
BASE_URL=http://localhost:3000
PORT=3000
# Bind the development server to the local machine.
TEAMOS_HOST=127.0.0.1

# SendGrid Mail Send API key and verified sender address.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Set to 1 when a local reverse proxy supplies the original client IP.
TRUST_LOCAL_PROXY=0

# Amazon Bedrock for transcript analysis and knowledge chunks.
# Set AI_PROVIDER=bedrock and pass a Bedrock API key through the server environment.
AI_PROVIDER=
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.amazon.nova-2-lite-v1:0
AWS_BEARER_TOKEN_BEDROCK=

# Direct Claude API is also supported with AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Direct OpenAI Responses API is supported with AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional model for ordinary assistant lookups and source selection.
OPENAI_LOOKUP_MODEL=

# Local storage (JSON + Markdown), used when S3_BUCKET is empty.
DATA_DIR=./storage

# Set S3_BUCKET to use S3 as the primary application store.
S3_BUCKET=
S3_REGION=eu-central-1
S3_OWNER_ACCOUNT=

# Signs session cookies. Generated in the selected storage backend if empty.
SESSION_SECRET=

# Dev login by email works only on localhost and only while SendGrid is not configured,
# unless you set DEV_LOGIN=1 explicitly. Set DEV_LOGIN=0 to turn it off.
DEV_LOGIN=
