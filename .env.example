# Public URL of this server (used for the Google OAuth redirect)
BASE_URL=http://localhost:3000
PORT=3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID → Web application)
# Authorized redirect URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API key for transcript analysis (without it, inbox items are saved and reviewed manually)
ANTHROPIC_API_KEY=

# Where files are stored (JSON + Markdown)
DATA_DIR=./data

# Signs session cookies. Generated into DATA_DIR/.secret if empty.
SESSION_SECRET=

# Dev login by email works only on localhost and only while Google OAuth is not configured,
# unless you set DEV_LOGIN=1 explicitly. Set DEV_LOGIN=0 to turn it off.
DEV_LOGIN=
